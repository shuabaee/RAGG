# Copy these into Streamlit Community Cloud -> your app -> Settings -> Secrets.
# Pick ONE provider. Without any key, RAGG still runs in extractive mode.

# Option A: Google Gemini (free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY = "paste-your-key-here"
# RAGG_MODEL = "gemini-2.5-flash"

# Option B: OpenAI or any OpenAI-compatible API (Groq, OpenRouter, ...)
# RAGG_PROVIDER = "openai"
# OPENAI_API_KEY = "paste-your-key-here"
# OPENAI_BASE_URL = "https://api.groq.com/openai/v1"   # leave out for OpenAI
# RAGG_MODEL = "llama-3.3-70b-versatile"               # e.g. gpt-4o-mini for OpenAI
