# Local: copy this file to .streamlit/secrets.toml (git-ignored) and fill it in.
# Streamlit Community Cloud: paste the same lines into your app -> Settings -> Secrets.
# Without any of these, RAGG uses local Ollama (http://localhost:11434).
# If Ollama is not running either, it still works in extractive mode.

# Option A: local Ollama (default)
# OLLAMA_HOST = "http://localhost:11434"
# RAGG_MODEL = "llama3"
# RAGG_EMBED_MODEL = "nomic-embed-text"

# Option B: ChatGPT via your OpenAI API key
# RAGG_PROVIDER = "openai"
# OPENAI_API_KEY = "sk-paste-your-key-here"
# RAGG_MODEL = "gpt-4o-mini"

# Option C: no model (extractive mode: verbatim passages only)
# RAGG_PROVIDER = "none"

# Option D: Aiki Labs Free Api which can only use gpt-6-luna
# RAGG_PROVIDER = "aiki"
# AIKI_API_KEY = "sk-paste-your-key-here"

# Reranking with FlashRank is on by default; set to "0" to turn it off.
# RAGG_RERANK = "1"

# Ollama only: reasoning models (qwen3, deepseek-r1...) think before answering, with a bigger
# token budget; their reasoning shows under a collapsed "Thought process" dropdown.
# On by default; set to "0" to turn it off.
# RAGG_THINK = "1"
